; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hold the Gate"
config/description="Prototype: lane defense with fixed units on build spots (the wall included) and tap-to-break loot crates."
run/main_scene="res://scenes/campaign.tscn"
run/max_fps.mobile=60
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Services="*res://src/platform/services_registry.gd"
Session="*res://src/ui/session.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=540
window/size/viewport_height=1170
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[game]

platform/provider="stub"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[importer_defaults]

texture={
"mipmaps/generate": true
}

[rendering]

environment/defaults/default_clear_color=Color(0.0784, 0.098, 0.133, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
