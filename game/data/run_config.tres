[resource]
script = ExtResource("cfg")
map = ExtResource("map")
maps = Array[ExtResource("t_maps")]([ExtResource("map"), ExtResource("map_canyon"), ExtResource("map_switchback")])
barricade = ExtResource("barricade")
skill_tree = ExtResource("skill_tree")
units = Array[ExtResource("t_units")]([ExtResource("units_0"), ExtResource("units_1"), ExtResource("units_2"), ExtResource("units_3"), ExtResource("units_4"), ExtResource("units_5")])
cards = Array[ExtResource("t_cards")]([ExtResource("cards_0"), ExtResource("cards_1"), ExtResource("cards_2"), ExtResource("cards_4"), ExtResource("cards_5"), ExtResource("cards_6"), ExtResource("cards_7"), ExtResource("cards_8"), ExtResource("cards_9"), ExtResource("cards_10"), ExtResource("cards_11"), ExtResource("cards_12")])
tips = Array[ExtResource("t_tips")]([ExtResource("tip_new_enemy"), ExtResource("tip_first_build"), ExtResource("tip_start_wave"), ExtResource("tip_crates"), ExtResource("tip_overdrive"), ExtResource("tip_siege"), ExtResource("tip_repair_gate"), ExtResource("tip_cards"), ExtResource("tip_upgrade"), ExtResource("tip_mastery"), ExtResource("tip_jam"), ExtResource("tip_unit_lost"), ExtResource("tip_new_portal"), ExtResource("tip_locked_pad"), ExtResource("tip_high_ground"), ExtResource("tip_barricade"), ExtResource("tip_campaign"), ExtResource("tip_skill_tree"), ExtResource("tip_ability_ready"), ExtResource("tip_ability_intro"), ExtResource("tip_synergy")])
synergies = Array[ExtResource("t_syn")]([ExtResource("syn_fire_team"), ExtResource("syn_suppressing_fire"), ExtResource("syn_cold_rounds"), ExtResource("syn_spotter"), ExtResource("syn_marked_targets"), ExtResource("syn_loader_team"), ExtResource("syn_interlocking_fire"), ExtResource("syn_shatter"), ExtResource("syn_crossfire"), ExtResource("syn_tracer_rounds"), ExtResource("syn_capacitor_link"), ExtResource("syn_deep_cold"), ExtResource("syn_brittle_ground"), ExtResource("syn_frozen_aim"), ExtResource("syn_superconductor"), ExtResource("syn_barrage"), ExtResource("syn_rangefinding"), ExtResource("syn_siege_battery"), ExtResource("syn_twin_scopes"), ExtResource("syn_kill_chain"), ExtResource("syn_grid_resonance")])
abilities = Array[ExtResource("t_abilities")]([ExtResource("ab_strike"), ExtResource("ab_cryo_bomb"), ExtResource("ab_napalm"), ExtResource("ab_minefield"), ExtResource("ab_repair")])
