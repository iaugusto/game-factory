[resource]
script = ExtResource("cfg")
map = ExtResource("map")
maps = Array[ExtResource("t_maps")]([ExtResource("map"), ExtResource("map_canyon")])
barricade = ExtResource("barricade")
units = Array[ExtResource("t_units")]([ExtResource("units_0"), ExtResource("units_1"), ExtResource("units_2"), ExtResource("units_3"), ExtResource("units_4"), ExtResource("units_5")])
cards = Array[ExtResource("t_cards")]([ExtResource("cards_0"), ExtResource("cards_1"), ExtResource("cards_2"), ExtResource("cards_4"), ExtResource("cards_5"), ExtResource("cards_6"), ExtResource("cards_7"), ExtResource("cards_8"), ExtResource("cards_9"), ExtResource("cards_10"), ExtResource("cards_11")])
meta_upgrades = Array[ExtResource("t_meta_upgrades")]([ExtResource("meta_upgrades_0"), ExtResource("meta_upgrades_1"), ExtResource("meta_upgrades_2"), ExtResource("meta_upgrades_3"), ExtResource("meta_upgrades_4"), ExtResource("meta_upgrades_5")])
