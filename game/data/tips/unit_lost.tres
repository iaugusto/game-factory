[gd_resource type="Resource" script_class="TipDef" format=3]

[ext_resource type="Script" path="res://src/defs/tip_def.gd" id="1_s"]
[ext_resource type="Script" path="res://src/defs/tip_card.gd" id="2_c"]

[sub_resource type="Resource" id="TipCard_0"]
script = ExtResource("2_c")
title = "Unit destroyed"
body = "Some enemies tear units apart. Rebuild on the empty pad."
focus = &"lost_pad"

[resource]
script = ExtResource("1_s")
id = &"unit_lost"
trigger = &"unit_destroyed"
priority = 65
cards = Array[ExtResource("2_c")]([SubResource("TipCard_0")])
