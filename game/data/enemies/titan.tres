keep_pace = true

[sub_resource type="Resource" id="ph_shed"]
script = ExtResource("2_p")
at_hp_fraction = 0.5
callout = "PLATES SHED — IT CHARGES"
spawn = ExtResource("3_warden")
spawn_count = 2
keep_pace = true
armor_delta = -6.0
speed_mult = 1.8
pause_seconds = 1.0

[resource]
script = ExtResource("1_s")
id = &"titan"
display_name = "Siege Titan"
description = "Plated, walled in by Wardens. At half health it sheds its plates and charges."
