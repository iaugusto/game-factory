[gd_resource type="Resource" script_class="EnemyDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/defs/enemy_def.gd" id="1_s"]
[ext_resource type="Script" path="res://src/defs/boss_phase.gd" id="2_p"]
[ext_resource type="Resource" path="res://data/enemies/warden.tres" id="3_warden"]

[sub_resource type="Resource" id="ph_escort"]
script = ExtResource("2_p")
at_hp_fraction = 1.0
spawn = ExtResource("3_warden")
