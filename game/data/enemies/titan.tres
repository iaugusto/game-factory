speed = 8.0
wall_damage = 70.0
attack_interval = 3.0
gold = 60
radius = 42.0
color = Color(0.45, 0.5, 0.58, 1)
weak_to = 8
resists = 1
armor = 6.0
threat = 270.0
is_boss = true
phases = Array[ExtResource("2_p")]([SubResource("ph_escort"), SubResource("ph_shed")])
